<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Creator Outreach Copilot</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0f0f0f;--bg2:#161616;--bg3:#1e1e1e;--bg4:#242424;
  --border:#2a2a2a;--border2:#383838;
  --text:#f0f0f0;--text2:#a0a0a0;--text3:#555;
  --accent:#7c6af7;--accent2:#5b4de0;--accent-bg:rgba(124,106,247,0.1);
  --green:#22c55e;--green-bg:rgba(34,197,94,0.1);
  --amber:#f59e0b;--amber-bg:rgba(245,158,11,0.1);
  --red:#ef4444;--red-bg:rgba(239,68,68,0.1);
  --teal:#2dd4bf;
  --radius:10px;--radius-sm:6px;
}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;font-size:14px;line-height:1.6}
.app{max-width:880px;margin:0 auto;padding:40px 24px 60px}

/* ── Header ── */
.header{margin-bottom:36px}
.header-top{display:flex;align-items:center;gap:12px;margin-bottom:6px}
.logo{width:38px;height:38px;background:var(--accent);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.title{font-size:24px;font-weight:600;letter-spacing:-0.6px}
.subtitle{color:var(--text2);font-size:13px;margin-left:50px;margin-bottom:10px}
.tags{display:flex;gap:7px;margin-left:50px;flex-wrap:wrap}
.tag{font-size:11px;padding:3px 9px;border-radius:20px;border:1px solid var(--border2);color:var(--text3)}
.tag.live{border-color:rgba(124,106,247,0.4);color:var(--accent);background:var(--accent-bg)}

/* ── API Key ── */
.api-section{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:12px 16px;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.api-icon{font-size:15px;flex-shrink:0}
.api-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-family:'DM Mono',monospace;font-size:12px;letter-spacing:0.4px}
.api-input::placeholder{color:var(--text3)}
.api-hint{font-size:11px;color:var(--text3);margin-left:50px;margin-bottom:16px;line-height:1.5}
.api-hint a{color:var(--accent);text-decoration:none}
.api-hint a:hover{text-decoration:underline}
.api-status{font-size:11px;padding:3px 9px;border-radius:20px;white-space:nowrap;flex-shrink:0}
.api-status.ok{background:var(--green-bg);color:var(--green)}
.api-status.bad{background:var(--amber-bg);color:var(--amber)}
.api-status.none{background:var(--bg3);color:var(--text3);border:1px solid var(--border)}

/* ── Mode Toggle ── */
.mode-toggle{display:flex;gap:6px;margin-bottom:24px;background:var(--bg2);border-radius:var(--radius);padding:4px;border:1px solid var(--border)}
.mode-btn{flex:1;padding:9px 12px;border-radius:8px;border:none;background:none;color:var(--text2);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;transition:all 0.15s}
.mode-btn.active{background:var(--bg4);color:var(--text)}

/* ── Preset Cards ── */
.preset-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px}
.preset-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:16px;cursor:pointer;transition:all 0.15s}
.preset-card:hover{border-color:var(--border2);background:var(--bg3)}
.preset-card.selected{border-color:var(--accent);background:var(--accent-bg)}
.p-priority{font-size:10px;font-weight:600;letter-spacing:0.8px;text-transform:uppercase;margin-bottom:8px}
.p-priority.high{color:var(--green)}
.p-priority.mid{color:var(--amber)}
.p-priority.low{color:var(--text3)}
.p-handle{font-size:14px;font-weight:600;margin-bottom:4px}
.p-meta{font-size:12px;color:var(--text2);margin-bottom:10px;line-height:1.5}
.p-score{font-size:22px;font-weight:600;font-family:'DM Mono',monospace;color:var(--accent)}

/* ── Stepper ── */
.stepper{display:flex;margin-bottom:20px;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
.step{flex:1;padding:10px;text-align:center;font-size:12px;font-weight:500;color:var(--text3);border-right:1px solid var(--border);transition:all 0.15s}
.step:last-child{border-right:none}
.step.active{background:var(--accent-bg);color:var(--accent)}
.step.done{color:var(--text2)}
.step-num{display:block;font-size:10px;font-family:'DM Mono',monospace;margin-bottom:2px}

/* ── Form ── */
.section-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:20px}
.section-label{font-size:13px;font-weight:600;margin-bottom:3px}
.section-hint{font-size:12px;color:var(--text3);margin-bottom:18px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:4px}
.form-full{grid-column:1/-1}
.field{display:flex;flex-direction:column;gap:5px}
label{font-size:11px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--text3)}
input,select,textarea{background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 11px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;outline:none;transition:border-color 0.15s;width:100%;-webkit-appearance:none}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
select{background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23666' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");background-repeat:no-repeat;background-position:right 10px center;background-size:16px;padding-right:32px}
select option{background:var(--bg3)}
textarea{resize:vertical;min-height:76px}
.sep{height:1px;background:var(--border);margin:16px 0}
.radio-group{display:flex;gap:8px;flex-wrap:wrap}
.radio-btn{padding:7px 14px;border:1px solid var(--border);border-radius:20px;cursor:pointer;font-size:12px;font-weight:500;color:var(--text2);transition:all 0.15s;background:var(--bg3);user-select:none}
.radio-btn.active{border-color:var(--accent);color:var(--accent);background:var(--accent-bg)}
.btn-row{display:flex;gap:10px;justify-content:space-between;align-items:center;margin-top:20px}
.btn-back{background:none;border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 16px;color:var(--text2);cursor:pointer;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;transition:all 0.15s}
.btn-back:hover{border-color:var(--border2);color:var(--text)}
.btn-primary{background:var(--accent);border:none;border-radius:var(--radius-sm);padding:10px 22px;color:#fff;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;transition:background 0.15s;display:flex;align-items:center;gap:8px}
.btn-primary:hover{background:var(--accent2)}
.btn-primary:disabled{opacity:0.5;cursor:not-allowed}

/* ── Results ── */
.result-panel{display:flex;flex-direction:column;gap:14px}
.score-hero{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);padding:22px;display:flex;align-items:center;gap:22px}
.score-ring{width:72px;height:72px;flex-shrink:0}
.score-info{flex:1}
.score-value{font-size:34px;font-weight:600;font-family:'DM Mono',monospace;line-height:1}
.score-sub{font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:0.6px;margin-top:3px}
.score-tags{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap}
.stag{font-size:11px;padding:3px 9px;border-radius:20px}
.stag.match{background:var(--green-bg);color:var(--green)}
.stag.warn{background:var(--amber-bg);color:var(--amber)}
.stag.miss{background:var(--red-bg);color:var(--red)}

.rcard{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
.rcard-head{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.rcard-title{font-size:11px;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:var(--text3)}
.rcard-body{padding:18px}
.rcard-body p{font-size:13px;line-height:1.75;color:var(--text2);margin-bottom:10px}
.rcard-body p:last-child{margin-bottom:0}

.email-wrap{background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-sm);padding:16px;font-size:13px;line-height:1.8;color:var(--text);white-space:pre-wrap;font-family:'DM Sans',sans-serif}
.copy-btn{font-size:11px;padding:5px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text2);cursor:pointer;font-family:'DM Sans',sans-serif;transition:all 0.15s}
.copy-btn:hover{border-color:var(--border2);color:var(--text)}
.email-subject{font-size:12px;color:var(--text3);margin-bottom:10px;font-family:'DM Mono',monospace}

/* ── Loading ── */
.loading-wrap{padding:40px;text-align:center}
.spinner{width:20px;height:20px;border:2px solid rgba(124,106,247,0.3);border-top-color:var(--accent);border-radius:50%;animation:spin 0.7s linear infinite;display:inline-block}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{font-size:13px;color:var(--text2);margin-top:14px}
.loading-sub{font-size:12px;color:var(--text3);margin-top:4px}

/* ── Error ── */
.error-msg{background:var(--red-bg);border:1px solid rgba(239,68,68,0.25);border-radius:var(--radius-sm);padding:12px 16px;color:var(--red);font-size:13px;line-height:1.6}

/* ── Footer ── */
.footer{margin-top:40px;padding-top:16px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:gap}
.footer span{font-size:11px;color:var(--text3)}

/* ── Batch Mode ── */
.filter-btn{padding:6px 12px;border:1px solid var(--border);border-radius:20px;cursor:pointer;font-size:12px;font-weight:500;color:var(--text2);background:var(--bg2);font-family:'DM Sans',sans-serif;transition:all 0.15s}
.filter-btn.active{border-color:var(--accent);color:var(--accent);background:var(--accent-bg)}
.batch-table{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
.batch-thead{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1.5fr 1fr;gap:0;border-bottom:1px solid var(--border);padding:10px 16px;font-size:11px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--text3)}
.batch-row{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1.5fr 1fr;gap:0;padding:12px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:background 0.12s;align-items:center}
.batch-row:last-child{border-bottom:none}
.batch-row:hover{background:var(--bg3)}
.batch-row.expanded{background:var(--accent-bg)}
.batch-cell{font-size:13px;color:var(--text)}
.batch-cell.dim{color:var(--text2);font-size:12px}
.priority-pill{display:inline-block;font-size:10px;font-weight:600;padding:3px 8px;border-radius:20px;letter-spacing:0.5px}
.priority-pill.high{background:var(--green-bg);color:var(--green)}
.priority-pill.mid{background:var(--amber-bg);color:var(--amber)}
.priority-pill.low{background:var(--red-bg);color:var(--red)}
.drawer-wrap{background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius);margin-top:6px;overflow:hidden}
.email-card{background:var(--bg2);border:1px solid rgba(34,197,94,0.25);border-radius:var(--radius);overflow:hidden;margin-bottom:12px}
.email-card-head{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.email-card-body{padding:16px}

/* ── Responsive ── */
@media(max-width:620px){
  .preset-grid{grid-template-columns:1fr}
  .form-grid{grid-template-columns:1fr}
  .score-hero{flex-direction:column;align-items:flex-start;gap:14px}
  .app{padding:24px 16px 48px}
}
</style>
</head>
<body>
<div class="app">

<!-- Header -->
<div class="header">
  <div class="header-top">
    <div class="logo">✦</div>
    <div class="title">AI Creator Outreach Copilot</div>
  </div>
  <div class="subtitle">输入甲方产品画像与 TikTok 达人数据，输出匹配评分、合作分析与个性化外联邮件</div>
  <div class="tags">
    <span class="tag live">Claude API 驱动</span>
    <span class="tag">TikTok Creator Matching</span>
    <span class="tag">跨境电商</span>
    <span class="tag">Prompt Engineering</span>
  </div>
</div>

<!-- API Key -->
<div class="api-section">
  <span class="api-icon">🔑</span>
  <input class="api-input" type="password" id="apiKeyInput"
    placeholder="输入 Anthropic API Key（sk-ant-...）以启用真实 AI 输出" autocomplete="off">
  <span class="api-status none" id="apiStatus">未配置</span>
</div>
<div class="api-hint">
  没有 API Key？前往 <a href="https://console.anthropic.com/keys" target="_blank">console.anthropic.com</a> 免费获取 ·
  Key 仅在本地使用，不经过任何服务器
</div>

<!-- Mode Toggle -->
<div class="mode-toggle">
  <button class="mode-btn active" id="btnPreset" onclick="switchMode('preset')">📋 预设案例演示</button>
  <button class="mode-btn" id="btnCustom" onclick="switchMode('custom')">✏️ 自定义输入</button>
  <button class="mode-btn" id="btnBatch" onclick="switchMode('batch')">⚡ 批量上传分析</button>
</div>

<!-- ═══════════════ PRESET MODE ═══════════════ -->
<div id="presetMode">
  <div class="preset-grid">
    <div class="preset-card selected" id="pc0" onclick="selectPreset(0)">
      <div class="p-priority high">优先级：高</div>
      <div class="p-handle">@beautybyella</div>
      <div class="p-meta">85万粉 · ER 4.8%<br>护肤 Routine · 美国为主</div>
      <div class="p-score">8.6<span style="font-size:13px;color:var(--text3)">/10</span></div>
    </div>
    <div class="preset-card" id="pc1" onclick="selectPreset(1)">
      <div class="p-priority mid">优先级：中</div>
      <div class="p-handle">@lifewithkate</div>
      <div class="p-meta">42万粉 · ER 3.1%<br>生活方式 · 英国为主</div>
      <div class="p-score">6.2<span style="font-size:13px;color:var(--text3)">/10</span></div>
    </div>
    <div class="preset-card" id="pc2" onclick="selectPreset(2)">
      <div class="p-priority low">优先级：低</div>
      <div class="p-handle">@gamerdave99</div>
      <div class="p-meta">120万粉 · ER 2.3%<br>游戏娱乐 · 多国混合</div>
      <div class="p-score">3.4<span style="font-size:13px;color:var(--text3)">/10</span></div>
    </div>
  </div>
  <div id="presetResult"></div>
</div>

<!-- ═══════════════ CUSTOM MODE ═══════════════ -->
<div id="customMode" style="display:none">
  <div class="stepper">
    <div class="step active" id="step1"><span class="step-num">01</span>产品画像</div>
    <div class="step" id="step2"><span class="step-num">02</span>达人数据</div>
    <div class="step" id="step3"><span class="step-num">03</span>AI 评估</div>
  </div>

  <!-- Step 1: Product -->
  <div id="formStep1" class="section-card">
    <div class="section-label">甲方产品画像</div>
    <div class="section-hint">填写产品基本信息，用于与达人受众做匹配分析</div>
    <div class="form-grid">
      <div class="field">
        <label>产品名称</label>
        <input type="text" id="f_pname" placeholder="例：GlowUp 玻尿酸精华">
      </div>
      <div class="field">
        <label>品类</label>
        <select id="f_pcat">
          <option value="">请选择</option>
          <option>护肤 / Skincare</option>
          <option>彩妆 / Makeup</option>
          <option>家居 / Home Decor</option>
          <option>3C 数码</option>
          <option>运动户外</option>
          <option>食品饮料</option>
          <option>时尚配饰</option>
          <option>宠物用品</option>
        </select>
      </div>
      <div class="field">
        <label>客单价（美元）</label>
        <input type="number" id="f_price" placeholder="例：49">
      </div>
      <div class="field">
        <label>目标市场</label>
        <select id="f_market">
          <option value="">请选择</option>
          <option>美国</option>
          <option>英国</option>
          <option>东南亚</option>
          <option>欧洲</option>
          <option>全球</option>
        </select>
      </div>
      <div class="field">
        <label>目标年龄段</label>
        <select id="f_age">
          <option value="">请选择</option>
          <option>13–17</option>
          <option>18–24</option>
          <option>25–34</option>
          <option>35–44</option>
          <option>45+</option>
        </select>
      </div>
      <div class="field">
        <label>性别偏向</label>
        <select id="f_gender">
          <option value="">请选择</option>
          <option>女性为主</option>
          <option>男性为主</option>
          <option>不限</option>
        </select>
      </div>
      <div class="field form-full">
        <label>核心卖点（3–5 个，逗号分隔）</label>
        <input type="text" id="f_usp" placeholder="例：天然成分、无香精、皮肤科测试认证、敏感肌可用">
      </div>
      <div class="field form-full">
        <label>消费场景</label>
        <textarea id="f_scene" placeholder="例：睡前护肤，适合追求轻护肤的都市女性"></textarea>
      </div>
    </div>
    <div class="btn-row">
      <span></span>
      <button class="btn-primary" onclick="goStep(2)">下一步：填写达人数据 →</button>
    </div>
  </div>

  <!-- Step 2: Creator -->
  <div id="formStep2" style="display:none" class="section-card">
    <div class="section-label">TikTok 达人数据</div>
    <div class="section-hint">填写达人基本数据，AI 将据此进行多维匹配评估</div>
    <div class="form-grid">
      <div class="field">
        <label>TikTok 用户名</label>
        <input type="text" id="c_handle" placeholder="@creatorname">
      </div>
      <div class="field">
        <label>粉丝量（万）</label>
        <input type="number" id="c_fans" placeholder="例：85">
      </div>
      <div class="field">
        <label>近30天 Engagement Rate (%)</label>
        <input type="number" id="c_er" placeholder="例：4.8" step="0.1">
      </div>
      <div class="field">
        <label>近30天均播放量（万）</label>
        <input type="number" id="c_views" placeholder="例：120">
      </div>
      <div class="field">
        <label>粉丝主要年龄段</label>
        <select id="c_age">
          <option value="">请选择</option>
          <option>13–17 为主</option>
          <option>18–24 为主</option>
          <option>25–34 为主</option>
          <option>35–44 为主</option>
          <option>45+ 为主</option>
        </select>
      </div>
      <div class="field">
        <label>TikTok Shop 情况</label>
        <select id="c_shop">
          <option value="">请选择</option>
          <option>已开通，有带货记录</option>
          <option>已开通，暂无带货</option>
          <option>未开通</option>
        </select>
      </div>
      <div class="field">
        <label>内容垂类</label>
        <select id="c_niche">
          <option value="">请选择</option>
          <option>护肤 / Skincare</option>
          <option>彩妆 / Makeup</option>
          <option>生活方式 / Lifestyle</option>
          <option>时尚 / Fashion</option>
          <option>健身 / Fitness</option>
          <option>美食 / Food</option>
          <option>科技 / Tech</option>
          <option>游戏 / Gaming</option>
          <option>家居 / Home</option>
        </select>
      </div>
      <div class="field">
        <label>内容风格</label>
        <select id="c_style">
          <option value="">请选择</option>
          <option>真实测评型</option>
          <option>生活记录 Vlog 型</option>
          <option>教程 Tutorial 型</option>
          <option>搞笑娱乐型</option>
          <option>专业知识型</option>
        </select>
      </div>
      <div class="field form-full">
        <label>粉丝国家 Top 3</label>
        <input type="text" id="c_countries" placeholder="例：美国 60%、英国 15%、加拿大 10%">
      </div>
      <div class="field form-full">
        <label>粉丝兴趣标签 Top 3</label>
        <input type="text" id="c_tags" placeholder="例：护肤、美妆、生活方式">
      </div>
    </div>
