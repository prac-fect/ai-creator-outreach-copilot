  document.getElementById('batchProgress').style.display = 'block';
  document.getElementById('batchStats').style.display = 'none';
  document.getElementById('batchToolbar').style.display = 'none';
  document.getElementById('batchTable').innerHTML = '';
  document.getElementById('batchDrawer').innerHTML = '';

  const key = getApiKey();
  const useAPI = key && key.startsWith('sk-ant-');

  for (let i = 0; i < total; i++) {
    const row = rows[i];
    const creator = csvRowToCreator(row);
    document.getElementById('progressLabel').textContent = `正在分析 ${creator.handle}…`;
    document.getElementById('progressCount').textContent = `${i + 1} / ${total}`;
    document.getElementById('progressBar').style.width = ((i + 1) / total * 100) + '%';

    let result;
    if (useAPI) {
      try {
        const data = { product, creator, tone: '自然真诚型', goal: '邀请免费寄样测评' };
        const text = await callClaude(buildPrompt(data));
        result = parseJSON(text);
      } catch(e) {
        result = generateMockResult({ product, creator, tone: '自然真诚型', goal: '邀请免费寄样测评' });
      }
    } else {
      // Simulate slight delay for dramatic effect
      await new Promise(r => setTimeout(r, 60));
      result = generateMockResult({ product, creator, tone: '自然真诚型', goal: '邀请免费寄样测评' });
    }

    batchResults.push({ creator, result });
  }

  // Done
  document.getElementById('batchProgress').style.display = 'none';
  document.getElementById('progressLabel').textContent = '分析完成';

  renderBatchStats();
  renderHighEmailPanel();
  renderBatchTable();

  document.getElementById('batchStats').style.display = 'block';
  document.getElementById('highEmailPanel').style.display = 'block';
  document.getElementById('batchToolbar').style.display = 'flex';
  document.getElementById('batchTable').style.display = 'block';
}

function renderBatchStats() {
  const high = batchResults.filter(r => r.result.priority === '高').length;
  const mid  = batchResults.filter(r => r.result.priority === '中').length;
  const low  = batchResults.filter(r => r.result.priority === '低').length;
  document.getElementById('statTotal').textContent = batchResults.length;
  document.getElementById('statHigh').textContent = high;
  document.getElementById('statMid').textContent = mid;
  document.getElementById('statLow').textContent = low;
}

function filterBatch(priority, btn) {
  batchFilter = priority;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  expandedRow = null;
  document.getElementById('batchDrawer').innerHTML = '';
  renderBatchTable();
}

function renderBatchTable() {
  const filtered = batchFilter === 'all'
    ? batchResults
    : batchResults.filter(r => r.result.priority === batchFilter);

  const sorted = [...filtered].sort((a, b) => b.result.score - a.result.score);
  const globalIndices = sorted.map(item => batchResults.indexOf(item));

  const tableEl = document.getElementById('batchTable');
  tableEl.innerHTML = `
    <div class="batch-table">
      <div class="batch-thead">
        <div>达人账号</div>
        <div>粉丝量</div>
        <div>ER</div>
        <div>评分</div>
        <div>优先级</div>
        <div>垂类</div>
      </div>
      ${sorted.map((item, i) => {
        const r = item.result;
        const c = item.creator;
        const gIdx = globalIndices[i];
        const pClass = r.priority === '高' ? 'high' : r.priority === '中' ? 'mid' : 'low';
        const scoreColor = r.score >= 7 ? 'var(--green)' : r.score >= 5 ? 'var(--amber)' : 'var(--red)';
        const isExpanded = expandedRow === gIdx;
        return `<div class="batch-row${isExpanded ? ' expanded' : ''}" onclick="toggleDrawer(${gIdx}, this)">
          <div class="batch-cell" style="font-weight:500">${c.handle}</div>
          <div class="batch-cell dim">${c.fans}</div>
          <div class="batch-cell dim">${c.er}</div>
          <div class="batch-cell" style="font-family:'DM Mono',monospace;color:${scoreColor};font-weight:600">${parseFloat(r.score).toFixed(1)}</div>
          <div class="batch-cell"><span class="priority-pill ${pClass}">${r.priority}优先级</span></div>
          <div class="batch-cell dim" style="font-size:12px">${(c.niche||'').split('/')[0].trim()}</div>
        </div>`;
      }).join('')}
    </div>`;

  // Re-inject drawer if a row is expanded
  if (expandedRow !== null) {
    renderDrawer(expandedRow);
  }
}

function toggleDrawer(globalIdx, rowEl) {
  if (expandedRow === globalIdx) {
    expandedRow = null;
    document.getElementById('batchDrawer').innerHTML = '';
    document.querySelectorAll('.batch-row').forEach(r => r.classList.remove('expanded'));
  } else {
    expandedRow = globalIdx;
    document.querySelectorAll('.batch-row').forEach(r => r.classList.remove('expanded'));
    rowEl.classList.add('expanded');
    renderDrawer(globalIdx);
  }
}

function renderDrawer(idx) {
  const item = batchResults[idx];
  if (!item) return;
  const r = item.result;
  const c = item.creator;
  const score = parseFloat(r.score);
  const color = score >= 7 ? 'var(--green)' : score >= 5 ? 'var(--amber)' : 'var(--red)';
  const circ = 2 * Math.PI * 22;
  const dash = (score / 10) * circ;
  const matchHTML = (r.match_tags || []).map(t => `<span class="stag match">${t}</span>`).join('');
  const warnHTML  = (r.warn_tags  || []).map(t => `<span class="stag warn">${t}</span>`).join('');
  const missHTML  = (r.miss_tags  || []).map(t => `<span class="stag miss">${t}</span>`).join('');
  const analysisHTML = (r.analysis || '').split('\n\n').map(p => `<p>${p}</p>`).join('');
  const drawerEl = document.getElementById('batchDrawer');
  drawerEl.innerHTML = `
    <div class="drawer-wrap">
      <div style="padding:18px">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px">
          <svg width="54" height="54" viewBox="0 0 54 54">
            <circle cx="27" cy="27" r="22" fill="none" stroke="var(--bg4)" stroke-width="5"/>
            <circle cx="27" cy="27" r="22" fill="none" stroke="${color}" stroke-width="5"
              stroke-dasharray="${dash.toFixed(1)} ${circ.toFixed(1)}" stroke-linecap="round" transform="rotate(-90 27 27)"/>
          </svg>
          <div>
            <div style="font-size:13px;font-weight:600;margin-bottom:2px">${c.handle}</div>
            <div style="font-size:22px;font-weight:600;font-family:'DM Mono',monospace;color:${color};line-height:1">${score.toFixed(1)}<span style="font-size:12px;color:var(--text3)">/10</span></div>
          </div>
          <div style="flex:1"></div>
          <button class="copy-btn" onclick="copyBatchEmail(${idx})">复制邮件</button>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">${matchHTML}${warnHTML}${missHTML}</div>
        <div style="font-size:12px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--text3);margin-bottom:8px">合作分析</div>
        <div style="font-size:13px;color:var(--text2);line-height:1.75;margin-bottom:14px">${analysisHTML}</div>
        <div style="font-size:12px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--text3);margin-bottom:8px">合作策略</div>
        <div style="font-size:13px;color:var(--text2);line-height:1.75;margin-bottom:14px">${r.strategy || ''}</div>
        <div style="font-size:12px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--text3);margin-bottom:6px">外联邮件</div>
        <div style="font-size:12px;color:var(--text3);margin-bottom:8px;font-family:'DM Mono',monospace">Subject: ${r.email_subject || ''}</div>
        <div class="email-wrap" id="drawerEmail${idx}" style="font-size:12px">${(r.email_body || '').replace(/\n/g, '<br>')}</div>
      </div>
    </div>`;
  drawerEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function copyBatchEmail(idx) {
  const el = document.getElementById('drawerEmail' + idx);
  if (!el) return;
  navigator.clipboard.writeText(el.innerText).then(() => {
    const btn = document.querySelector('.drawer-wrap .copy-btn');
    if (btn) { btn.textContent = '已复制 ✓'; setTimeout(() => btn.textContent = '复制邮件', 2000); }
  });
}

function renderHighEmailPanel() {
  const highItems = batchResults
    .filter(r => r.result.priority === '高')
    .sort((a, b) => b.result.score - a.result.score);

  const container = document.getElementById('highEmailCards');

  if (!highItems.length) {
    container.innerHTML = '<div style="font-size:13px;color:var(--text3);padding:12px 0">本次分析未发现高优先级达人</div>';
    return;
  }

  container.innerHTML = highItems.map((item, i) => {
    const r = item.result;
    const c = item.creator;
    const gIdx = batchResults.indexOf(item);
    const score = parseFloat(r.score);
    const scoreColor = score >= 7 ? 'var(--green)' : 'var(--amber)';
    const matchHTML = (r.match_tags || []).map(t => `<span class="stag match">${t}</span>`).join('');
    const warnHTML  = (r.warn_tags  || []).map(t => `<span class="stag warn">${t}</span>`).join('');
    const emailBody = (r.email_body || '').replace(/\n/g, '<br>');

    return `<div class="email-card">
      <div class="email-card-head">
        <div style="flex:1">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
            <span style="font-weight:600;font-size:14px">${c.handle}</span>
            <span style="font-family:'DM Mono',monospace;font-size:13px;font-weight:600;color:${scoreColor}">${score.toFixed(1)}/10</span>
            <span class="priority-pill high">高优先级</span>
          </div>
          <div style="display:flex;gap:5px;flex-wrap:wrap">${matchHTML}${warnHTML}</div>
        </div>
        <button class="copy-btn" onclick="copyHighEmail(${gIdx}, this)">复制邮件</button>
      </div>
      <div class="email-card-body">
        <div style="font-size:11px;color:var(--text3);font-family:'DM Mono',monospace;margin-bottom:8px">
          Subject: ${r.email_subject || ''}
        </div>
        <div class="email-wrap" id="highEmail${gIdx}" style="font-size:13px">${emailBody}</div>
      </div>
    </div>`;
  }).join('');
}

function copyHighEmail(idx, btn) {
  const el = document.getElementById('highEmail' + idx);
  if (!el) return;
  navigator.clipboard.writeText(el.innerText).then(() => {
    btn.textContent = '已复制 ✓';
    setTimeout(() => btn.textContent = '复制邮件', 2000);
  });
}

function copyAllHighEmails() {
  const highItems = batchResults.filter(r => r.result.priority === '高').sort((a,b) => b.result.score - a.result.score);
  const text = highItems.map(item => {
    const r = item.result;
    const c = item.creator;
    return `=== ${c.handle} (${parseFloat(r.score).toFixed(1)}/10) ===\nSubject: ${r.email_subject}\n\n${r.email_body}\n`;
  }).join('\n' + '─'.repeat(50) + '\n\n');
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.querySelector('#highEmailPanel .btn-back');
    if (btn) { btn.textContent = '已全部复制 ✓'; setTimeout(() => btn.textContent = '复制全部邮件', 2500); }
  });
}

function exportCSV() {
  if (!batchResults.length) return;
  const headers = ['handle','fans','er','views','niche','score','priority','strategy','email_subject','email_body'];
  const rows = batchResults.map(item => {
    const c = item.creator, r = item.result;
    return [c.handle, c.fans, c.er, c.views, c.niche, r.score, r.priority,
      '"' + (r.strategy||'').replace(/"/g,'""') + '"',
      '"' + (r.email_subject||'').replace(/"/g,'""') + '"',
      '"' + (r.email_body||'').replace(/"/g,'""').replace(/\n/g,' ') + '"'
    ].join(',');
  });
  const csv = [headers.join(','), ...rows].join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'creator_outreach_results.csv';
  a.click(); URL.revokeObjectURL(url);
}

function downloadTemplate() {
  const template = `handle,fans_w,er,views_w,age,shop,niche,style,countries,interests
@creatorname,85,4.8,120,25–34为主,已开通，有带货记录,护肤 / Skincare,真实测评型,"美国60%、英国15%、加拿大10%","护肤、美妆、生活方式"`;
  const blob = new Blob([template], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'creator_template.csv';
  a.click(); URL.revokeObjectURL(url);
}

function resetBatch() {
  batchResults = []; expandedRow = null; batchFilter = 'all';
  document.getElementById('uploadZone').style.display = 'block';
  document.getElementById('batchProgress').style.display = 'none';
  document.getElementById('batchStats').style.display = 'none';
  document.getElementById('batchToolbar').style.display = 'none';
  document.getElementById('batchTable').innerHTML = '';
  document.getElementById('batchDrawer').innerHTML = '';
  document.getElementById('csvFileInput').value = '';
  document.querySelectorAll('.filter-btn').forEach((b,i) => b.classList.toggle('active', i===0));
  document.getElementById('highEmailPanel').style.display = 'none';
  document.getElementById('highEmailCards').innerHTML = '';
}

/* ── Init ── */
selectPreset(0);
</script>
