  else if (c.shop === '已开通，暂无带货') score += 0.3;
  else score -= 0.5;

  const ageMatch = c.age && p.age && c.age.includes(p.age.split('–')[0]);
  if (ageMatch) score += 0.5;

  const marketMatch = c.countries && p.market && c.countries.includes(p.market);
  if (!marketMatch && p.market !== '全球') score -= 0.8;

  score = Math.min(9.8, Math.max(1.5, parseFloat(score.toFixed(1))));
